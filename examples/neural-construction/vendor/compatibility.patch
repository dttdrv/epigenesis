+                if (actualLength != previousLength) {
+                    java.util.Set<double[]> points = java.util.Collections.newSetFromMap(new java.util.IdentityHashMap<>());
+                    for (Excrescence site : excrescences) points.add(site.getPositionOnPO());
+                    for (PhysicalBond bond : physicalBonds) points.add(bond.getPositionOnObjectInLocalCoord(this));
+                    // uniform passive strain transports material sites; tip addition is a separate operation.
+                    for (double[] point : points) point[0] = (point[0]/previousLength)*actualLength;
+                }
+            }
+            updateLocalCoordinateAxis();
+        } finally {
+            getRwLock().writeLock().unlock();
+        }
+    }
