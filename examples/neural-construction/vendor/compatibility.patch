+            double previousLength = actualLength;
+            updateDependentPhysicalVariables();
+            if (!excrescences.isEmpty() || !physicalBonds.isEmpty()) {
+                if (!(previousLength > 0) || !(actualLength > 0) || !Double.isFinite(previousLength) || !Double.isFinite(actualLength))
